{
  "name": "flows-discovery",
  "version": "1.1.0",
  "description": "Flows Discovery - SD-WAN Flows Analysis",
  "main": "main.js",
  "homepage": "./",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.6.4"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.extremenetworks.flows-discovery",
    "productName": "Flows Discovery",
    "files": [
      "main.js",
      "index.html",
      "icon.ico",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "sign": null
    }
  }
}
